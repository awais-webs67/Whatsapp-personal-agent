# All optional. Copy to .env and export, or set in your process manager.
PORT=3000
# Where the database, WhatsApp sessions and encryption key live. Back this folder up.
DATA_DIR=./data
# Encrypts saved API keys. If unset, a random key is generated in DATA_DIR/secret.key.
APP_SECRET=
# Route the WhatsApp (QR) connection through a proxy that allows WebSocket upgrades.
WA_PROXY=
